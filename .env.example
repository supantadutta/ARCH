# ---------------------------------------------------------------------------
# AutoBugHunter environment configuration. Copy to `.env` before running.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=abh
POSTGRES_PASSWORD=abh
POSTGRES_DB=autobughunter
DATABASE_URL=postgresql://abh:abh@postgres:5432/autobughunter

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Storage paths (inside containers) --------------------------------------
EVIDENCE_DIR=/evidence
REPORTS_DIR=/reports

# --- SAFETY CONTROLS --------------------------------------------------------
# Dry-run is ON by default. Scanners log the command they WOULD run but never
# execute external tooling. Set to false only in an authorized lab environment.
DRY_RUN=true

# Global kill switch. When true, no new scans can be queued or executed.
KILL_SWITCH_ENABLED=false

# Rate limit budget for scanner execution (requests/second).
SCANNER_RATE_LIMIT_PER_SEC=2.0

# Allow scanning private/internal IP ranges. OFF by default. Loopback is still
# permitted when explicitly added to a program's scope (the demo flow).
ALLOW_PRIVATE_TARGETS=false

# --- AUTHORIZATION ----------------------------------------------------------
# Strict authorization. When true, every API request must present either a
# valid JWT (Authorization: Bearer ...) or the X-API-Key header.
AUTH_ENABLED=true
API_KEY=dev-local-key

# JWT signing. CHANGE JWT_SECRET to a strong random value in production.
JWT_SECRET=change-me-dev-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Seed admin account (created on first boot). Change in production.
DEFAULT_ADMIN_EMAIL=admin@localhost
DEFAULT_ADMIN_PASSWORD=admin12345

# --- SLA policy (days to remediate, per severity; 0 = untracked) ------------
SLA_DAYS_CRITICAL=3
SLA_DAYS_HIGH=7
SLA_DAYS_MEDIUM=30
SLA_DAYS_LOW=90
SLA_DAYS_INFO=0

# --- Background job retry policy --------------------------------------------
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF=5

# --- Notifications (placeholder) --------------------------------------------
# "log" writes to the app log; "webhook" POSTs to NOTIFY_WEBHOOK_URL.
NOTIFY_PROVIDER=log
NOTIFY_WEBHOOK_URL=

# --- AI TRIAGE PROVIDER -----------------------------------------------------
# Provider: mock (default, offline, deterministic), openai (OpenAI-compatible
# endpoint), or local (self-hosted LLM placeholder). The mock provider keeps the
# platform fully runnable with no external calls.
AI_PROVIDER=mock

# OpenAI-compatible provider (used only when AI_PROVIDER=openai).
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# Local LLM placeholder (used only when AI_PROVIDER=local).
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_MODEL=llama3

# Hard timeout (seconds) for any AI provider HTTP call.
AI_REQUEST_TIMEOUT=30

# --- EXTERNAL SCANNERS (all OPT-IN, disabled by default) --------------------
# A scanner runs for real only when it is BOTH enabled here AND its binary is
# installed in the worker image. Recon is pure-Python and always available.
# Dry-run preview works regardless of these flags.
ENABLE_NUCLEI=false
ENABLE_ZAP=false
ENABLE_SEMGREP=false
ENABLE_GITLEAKS=false
ENABLE_TRIVY=false

# Per-scan wall-clock timeout (seconds) for external tools.
SCANNER_TIMEOUT_SECONDS=600

# Nuclei: tags excluded so only safe / non-intrusive templates run.
NUCLEI_EXCLUDED_TAGS=dos,fuzz,brute,intrusive,sqli-exploit,xss-exploit

# Explicitly authorized LOCAL paths for path-based scanners (semgrep, gitleaks,
# trivy). Comma-separated absolute roots. A target must live under one of these
# roots AND have a matching repo/mobile_app scope entry, or it is rejected.
# Empty => local path scanning is disabled.
AUTHORIZED_SCAN_PATHS=

# --- Optional local vulnerable target (DISABLED BY DEFAULT) -----------------
# A safe, intentionally-misconfigured local demo target for scanning. It is NOT
# started unless you opt in with the compose `vuln` profile:
#   docker compose --profile vuln up --build
ENABLE_VULNERABLE_TARGET=false
VULNERABLE_TARGET_URL=http://vulnerable-target:9000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Must match API_KEY above so the dashboard can authenticate.
NEXT_PUBLIC_API_KEY=dev-local-key
